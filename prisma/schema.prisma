// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id           String   @id @default(cuid())
  name         String   @default("Admin")
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Property {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  dealType        String   // "rent" or "lease"
  usageType       String   // "residential" or "commercial"
  propertySubtype String?  // e.g., "apartment", "villa", "office"
  areaName        String
  city            String   @default("Chennai")
  priceInr        Int
  isNegotiable    Boolean  @default(false)
  sizeSqft        Int
  bedrooms        Int?
  bathrooms       Int?
  parking         String?  // e.g., "2 covered", "1 open"
  topFacilities   String?  // JSON array: ["Swimming Pool", "Gymnasium", ...]
  locationAdvantages String? // JSON array: [{name: "School Name", type: "School", distance: "2.5 Kms"}, ...]
  
  // Specifications
  floorNumber       Int?     // e.g., 12
  totalFloors       Int?     // e.g., 19
  furnishing        String?  // "Fully Furnished", "Semi Furnished", "Unfurnished"
  tenantPreference  String?  // "Family", "Single Men", "Single Women", "Anyone"
  carpetAreaSqft    Int?     // Carpet area (usable area)
  availableFrom     DateTime?
  propertyAge       String?  // "0-1 Year", "1-5 Years", "5-10 Years", "10+ Years", "Under Construction"
  
  // Dynamic Property Details & Custom Sections
  propertyDetails  String?  // JSON: [{key: "Layout", value: "3 BHK"}, ...]
  customSections   String?  // JSON: [{id, title, type, content}, ...]
  sectionOrder     String?  // JSON: ["basic-info", "specs", "custom-1", ...]
  sectionNames     String?  // JSON: {"specifications": "Key Highlights", ...}

  // Editable Highlights & FAQ (auto-generated with admin override)
  customHighlights String?  // JSON: [{icon, label, value}, ...]
  customFaqs       String?  // JSON: [{q, a}, ...]

  tourEmbedUrl    String?  // Made optional
  images          String?  // JSON array of image paths
  advanceMonths   Int?     // For rent: 3, 6, 9, or 12 months
  leasePeriodYears Int?    // For lease: 1-10 years
  // Verification & Lifestyle
  isVerified         Boolean  @default(false)
  isBachelorFriendly Boolean  @default(false)
  isPetFriendly      Boolean  @default(false)
  isVegetarianOnly   Boolean  @default(false)

  isPublished     Boolean  @default(false)
  isFeatured      Boolean  @default(false)
  isRentedOut     Boolean  @default(false)
  viewCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shortlists      Shortlist[]

  @@index([dealType])
  @@index([usageType])
  @@index([areaName])
  @@index([isPublished])
  @@index([isFeatured])
}

model SiteSettings {
  id                   String   @id @default(cuid())
  brandName            String   @default("Tolet Board Chennai")
  tagline              String   @default("360° Tours • Rent & Lease • Chennai")
  city                 String   @default("Chennai")
  whatsappNumber       String   @default("+919876543210")
  phoneNumber          String   @default("+919876543210")
  whatsappTemplate     String   @default("Hi, I'm interested in {propertyTitle}. Link: {propertyUrl}")
  
  // CMS — Homepage content
  heroTitle            String   @default("Tolet Board Chennai")
  heroSubtitle         String   @default("Find Your Perfect Space")
  heroCta              String   @default("Browse Properties")
  categoryHeading      String   @default("Browse by Category")
  typeHeading          String   @default("Browse by Type")
  recentHeading        String   @default("Recently Added")
  footerText           String   @default("© 2026 Tolet Board Chennai. All rights reserved.")
  
  // CMS — List page content
  listPageTitle        String   @default("Properties")
  
  // CMS — Lead popup
  leadPopupTitle       String   @default("Looking for a Property?")
  leadPopupSubtitle    String   @default("Tell us what you need — we'll find it for you!")
  
  // Amenities vocabulary
  amenitiesVocabulary  String?  // JSON array of amenity names
  
  updatedAt            DateTime @updatedAt
}

model User {
  id                   String      @id @default(cuid())
  name                 String
  email                String?
  phone                String      @unique
  whatsappNumber       String?
  wantsWhatsappUpdates Boolean     @default(false)
  passwordHash         String
  shortlists           Shortlist[]
  createdAt            DateTime    @default(now())
}

model Manager {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  permissions  String?  // JSON: {"viewLeads":true,"viewUsers":true,"viewProperties":true}
  createdAt    DateTime @default(now())
}

model Shortlist {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
}

model LeadFormResponse {
  id            String   @id @default(cuid())
  name          String
  phone         String
  email         String?
  lookingFor    String   // "rent" or "lease"
  propertyType  String?  // "apartment", "villa", etc.
  budgetRange   String?
  preferredArea String?
  message       String?
  createdAt     DateTime @default(now())
}

model Lead {
  id              String    @id @default(cuid())
  leadType        String    // "owner" or "tenant"
  source          String    @default("other") // "website","whatsapp","meta_ad","instagram","referral","walk_in","other"

  name            String
  phone           String
  email           String?
  whatsappNumber  String?

  // Owner-specific
  propertyAddress String?
  propertyType    String?
  expectedRent    Int?

  // Tenant-specific
  lookingFor      String?   // "rent" or "lease"
  budgetRange     String?
  preferredArea   String?
  bhkPreference   String?

  // Status & Follow-up
  status          String    @default("new")
  assignedTo      String?
  followUpDate    DateTime?
  notes           String?   // JSON: [{date,note,by}]

  // Closure
  closedVia       String?   // "our_platform","outside_broker","direct","other"
  closedPropertyId String?

  message         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([leadType])
  @@index([status])
  @@index([source])
}
model ChangeRequest {
  id            String   @id @default(cuid())
  type          String   // "edit_property", "delete_property", "edit_lead", "delete_lead", "status_lead", "switch_lead"
  entityType    String   // "property" or "lead"
  entityId      String
  entityTitle   String   // human-readable label
  changes       String?  // JSON of proposed changes
  reason        String?
  requestedBy   String
  status        String   @default("pending") // "pending", "approved", "rejected"
  reviewedBy    String?
  reviewNote    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([entityType])
}

model OnboardingSubmission {
  id                   String      @id @default(cuid())
  formType             String      // "owner" or "tenant"
  status               String      @default("pending") // "pending", "verified", "rejected"
  
  // Common fields
  name                 String
  phone                String
  whatsappNumber       String?
  email                String?
  wantsWhatsappUpdates Boolean     @default(false)

  // Tenant specific
  tenantType           String?     // e.g., "Family (Veg Only)"
  preferredAreas       String?     // Comma separated or text
  propertyType         String?
  budgetRange          String?
  bedrooms             String?
  moveInDate           DateTime?

  // Owner specific (placeholder fields)
  propertyAddress      String?
  propertyDetails      String?     // JSON string for other details

  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([formType])
  @@index([status])
}
